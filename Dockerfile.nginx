# Nginx image that proxies to PHP service (fastcgi_pass php:9000)
FROM nginx:stable-alpine

# Remove default config and add our site config
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose the HTTP port that App Platform will route to (8080)
EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]